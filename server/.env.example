# 실제 값은 프로젝트 루트 .env(D:\repo\time_base_todolist\.env, gitignored)에 저장한다.
# 이 파일은 필요한 변수 이름만 문서화하는 용도이며 실제 값을 기록하지 않는다.
QWEN_KEY=
MEETING_AI_API_URL=
MEETING_AI_MODEL=qwen3.8-max

# Firestore(서버는 firebase-admin으로만 접근, 클라이언트에는 노출하지 않음)
FIREBASE_PROJECT_ID=
# 리포 루트 기준 상대경로. 서비스 계정 키 파일 자체는 반드시 .gitignore에 추가할 것.
FIREBASE_SERVICE_ACCOUNT_PATH=
